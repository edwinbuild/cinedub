# Local API
CINEDUB_ENV=development
CINEDUB_API_HOST=127.0.0.1
CINEDUB_API_PORT=8000
CINEDUB_DATABASE_URL=sqlite:///./data/cinedub.db
CINEDUB_STORAGE_ROOT=./data/storage
CINEDUB_WEB_ORIGIN=http://127.0.0.1:3000
CINEDUB_MAX_UPLOAD_BYTES=1073741824
CINEDUB_MAX_DURATION_SECONDS=120

# Capability routing. Valid initial values: fake, sarvam, local
CINEDUB_TRANSCRIBER=sarvam
# In v0.2, diarization runs with the selected batch transcriber.
CINEDUB_TRANSLATOR=sarvam
CINEDUB_VOICE_SYNTHESIZER=sarvam
CINEDUB_PERFORMANCE_ANALYZER=local
CINEDUB_STEM_SEPARATOR=local
CINEDUB_TIMING_ALIGNER=local
CINEDUB_TRANSCRIPTION_MODEL=saaras:v4
CINEDUB_TRANSLATION_MODEL=mayura:v1
CINEDUB_TRANSLATION_STYLE=modern-colloquial
CINEDUB_PROJECT_BUDGET_INR=50
CINEDUB_STT_DIARIZATION_INR_PER_HOUR=45
CINEDUB_TRANSLATION_INR_PER_10K_CHARS=20
CINEDUB_SYNTHESIS_MODEL=bulbul:v3
CINEDUB_SYNTHESIS_INR_PER_10K_CHARS=30
CINEDUB_MAX_TIMING_SPEEDUP=1.15

# Optional offline English ASR. Explicitly install/download before selecting local.
# uv sync --extra local-asr --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-asr.py
CINEDUB_LOCAL_ASR_MODEL_DIR=./models/faster-whisper-small.en
CINEDUB_LOCAL_ASR_THREADS=4
CINEDUB_LOCAL_ASR_TIMEOUT_SECONDS=600

# Optional offline cinematic separation. No downloads during a processing job.
# uv sync --extra local-asr --extra local-separation --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-separation.py
CINEDUB_LOCAL_SEPARATOR_MODEL_DIR=./models/mrx
CINEDUB_LOCAL_SEPARATOR_THREADS=4
CINEDUB_LOCAL_SEPARATOR_TIMEOUT_SECONDS=900

# Sarvam remains disabled until a key is supplied.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Web
NEXT_PUBLIC_CINEDUB_API_URL=http://127.0.0.1:8000
