# Local API
CINEDUB_ENV=development
CINEDUB_API_HOST=127.0.0.1
CINEDUB_API_PORT=8000
CINEDUB_DATABASE_URL=sqlite:///./data/cinedub.db
CINEDUB_STORAGE_ROOT=./data/storage
CINEDUB_WEB_ORIGIN=http://127.0.0.1:3000
CINEDUB_MAX_UPLOAD_BYTES=1073741824
CINEDUB_MAX_DURATION_SECONDS=120

# Capability routing. Valid values per stage: fake, sarvam, local (see config.py).
# `fake` selects a deterministic, visibly labelled DEMO provider for every stage. It needs no
# model or key, exercises the real job/review/export paths and is never quality evidence.
# DEMO providers are refused when CINEDUB_ENV=production unless explicitly allowed.
# CINEDUB_ALLOW_DEMO_PROVIDERS=false
CINEDUB_TRANSCRIBER=sarvam
# In v0.2, diarization runs with the selected batch transcriber.
CINEDUB_TRANSLATOR=sarvam
# Independent optional context-capable stage; never silently replaces translation.
CINEDUB_DIALOGUE_ADAPTER=local
CINEDUB_VOICE_SYNTHESIZER=sarvam
CINEDUB_PERFORMANCE_ANALYZER=local
CINEDUB_STEM_SEPARATOR=local
CINEDUB_TIMING_ALIGNER=local
CINEDUB_TARGET_TIMING_ALIGNER=local
CINEDUB_EMOTION_ANALYZER=local
CINEDUB_TRANSCRIPTION_MODEL=saaras:v4
CINEDUB_TRANSLATION_MODEL=mayura:v1
CINEDUB_TRANSLATION_STYLE=modern-colloquial
CINEDUB_PROJECT_BUDGET_INR=50
CINEDUB_STT_DIARIZATION_INR_PER_HOUR=45
CINEDUB_TRANSLATION_INR_PER_10K_CHARS=20
CINEDUB_SYNTHESIS_MODEL=bulbul:v3
CINEDUB_SYNTHESIS_INR_PER_10K_CHARS=30
CINEDUB_MAX_TIMING_SPEEDUP=1.15

# Optional offline English ASR. Explicitly install/download before selecting local.
# uv sync --extra local-asr --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-asr.py
CINEDUB_LOCAL_ASR_MODEL_DIR=./models/faster-whisper-small.en
CINEDUB_LOCAL_ASR_THREADS=4
CINEDUB_LOCAL_ASR_TIMEOUT_SECONDS=600

# Optional offline cinematic separation. No downloads during a processing job.
# uv sync --extra local-asr --extra local-separation --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-separation.py
CINEDUB_LOCAL_SEPARATOR_MODEL_DIR=./models/mrx
CINEDUB_LOCAL_SEPARATOR_THREADS=4
CINEDUB_LOCAL_SEPARATOR_TIMEOUT_SECONDS=900

# Optional English source-word alignment and acoustic measurements (not emotion labels).
# uv sync --extra local-asr --extra local-separation --extra local-alignment --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-alignment.py
CINEDUB_LOCAL_ALIGNER_MODEL_DIR=./models/wav2vec2-english
CINEDUB_LOCAL_ALIGNER_THREADS=4
CINEDUB_LOCAL_ALIGNER_TIMEOUT_SECONDS=600

# Optional experimental Malayalam take-word suggestions; acoustic comparisons need no weights.
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-target-alignment.py
CINEDUB_LOCAL_TARGET_ALIGNER_MODEL_DIR=./models/wav2vec2-malayalam
CINEDUB_LOCAL_TAKE_ANALYZER_TIMEOUT_SECONDS=900

# Optional experimental CPU dialogue alternatives. ~2.5 GB model; no runtime download.
# uv sync --extra local-dialogue --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-dialogue.py
CINEDUB_LOCAL_DIALOGUE_MODEL_DIR=./models/qwen3-dialogue
CINEDUB_LOCAL_DIALOGUE_THREADS=4
CINEDUB_LOCAL_DIALOGUE_TIMEOUT_SECONDS=1800

# Optional English audio-only emotion hints; never automatically changes voice direction.
# uv sync --extra local-emotion --group dev
# PYTHONPATH=apps/api .venv/bin/python scripts/setup-local-emotion.py
CINEDUB_EMOTION_ANALYZER=local
CINEDUB_LOCAL_EMOTION_MODEL_DIR=./models/speech-emotion
CINEDUB_LOCAL_EMOTION_THREADS=4
CINEDUB_LOCAL_EMOTION_TIMEOUT_SECONDS=900

# Sarvam remains disabled until a key is supplied.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Web
NEXT_PUBLIC_CINEDUB_API_URL=http://127.0.0.1:8000
